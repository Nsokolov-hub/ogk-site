# Backend of the site (backend/, docker-compose.yml). Copy to .env; .env is not committed.
ENVIRONMENT=development
POSTGRES_PASSWORD=site
SITE_URL=https://www.ogk-chem.ru

# CRM, flow F1. Token and secret: in the CRM run
#   docker compose exec api python -m app.integrations.site_tokens create --name staging
# and add the site server's address to SITE_INTEGRATION_ALLOWED_IPS of the CRM.
# While CRM_DELIVERY_ENABLED=false requests wait in the queue and sales get them by e-mail.
CRM_URL=http://host.docker.internal:8000
CRM_TOKEN=
CRM_SIGNING_SECRET=
CRM_DELIVERY_ENABLED=false

# Search (Meilisearch, TZ 6). The key is shared by the meilisearch service and the API; in production set
# MEILI_ENV=production and a random key of at least 16 bytes.
MEILI_MASTER_KEY=development-master-key-0123456789
MEILI_ENV=development

# The worker drops the storefront's cached pages of changed products: the same random secret for both.
REVALIDATE_SECRET=

# Mail. In development every letter goes to Mailpit: http://127.0.0.1:8025
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_STARTTLS=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=ОГК-ХИМ <noreply@ogk-chem.ru>
MAIL_REPLY_TO=order@ogk-chem.ru
SALES_EMAIL=order@ogk-chem.ru
ALERT_EMAILS=order@ogk-chem.ru

# Alerts about undelivered requests (no personal data goes to Telegram).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_AFTER_MINUTES=15

# Yandex SmartCaptcha, asked only on suspicion. Empty: suspicious requests pass and are marked.
SMARTCAPTCHA_SERVER_KEY=

# Storefront (Next.js): where /api/v1/* is proxied in development, and the SmartCaptcha client key.
API_ORIGIN=http://127.0.0.1:8001
NEXT_PUBLIC_SMARTCAPTCHA_SITE_KEY=
