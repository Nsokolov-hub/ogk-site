# Settings of the site (docker-compose.yml). Copy to .env; .env is not committed.
# A staging or production server: python3 scripts/init-env.py staging … fills the secrets (deploy/README.md).
ENVIRONMENT=development
POSTGRES_PASSWORD=site
SITE_URL=https://www.ogk-chem.ru

# ── staging and production (docker-compose.prod.yml, deploy/README.md) ──
# staging | production; empty in development
SITE_ENV=
SITE_DOMAIN=
# Other names of the site answering 301 to SITE_DOMAIN (production), e.g. ogk-chem.ru
SITE_ALIASES=
TLS_EMAIL=
# Staging password: user and the bcrypt hash made by `caddy hash-password`, in single quotes
STAGING_USER=ogk
STAGING_PASSWORD_HASH=
# mailpit — letters of staging stay in Mailpit at https://<SITE_DOMAIN>/mailpit/
COMPOSE_PROFILES=
# Base copies (scripts/backup.sh) and the journal archive of PostgreSQL; the sync command copies them off the server
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=7
BACKUP_SYNC_COMMAND=
ARCHIVE_TIMEOUT=600
# PostgreSQL memory: about a quarter and three quarters of the server's RAM
PG_SHARED_BUFFERS=1GB
PG_EFFECTIVE_CACHE_SIZE=3GB

# CRM, flow F1. Token and secret: in the CRM run
#   docker compose exec api python -m app.integrations.site_tokens create --name staging
# and add the site server's address to SITE_INTEGRATION_ALLOWED_IPS of the CRM.
# While CRM_DELIVERY_ENABLED=false requests wait in the queue and sales get them by e-mail.
CRM_URL=http://host.docker.internal:8000
CRM_TOKEN=
CRM_SIGNING_SECRET=
CRM_DELIVERY_ENABLED=false

# Search (Meilisearch, TZ 6). The key is shared by the meilisearch service and the API; in production set
# MEILI_ENV=production and a random key of at least 16 bytes.
MEILI_MASTER_KEY=development-master-key-0123456789
MEILI_ENV=development

# Shared secret of the storefront and the API: cache drops after catalog changes, and the storefront's cached
# requests are not counted against the search limits. The same random value for both.
REVALIDATE_SECRET=

# Error reports to Sentry or GlitchTip: the API and worker, and the storefront's server rendering. Empty — logs only.
SENTRY_DSN=
WEB_SENTRY_DSN=

# Counters (TZ 15.1), loaded after the consent to analytics cookies: Yandex Metrika number and GA4 G-XXXXXXX.
YM_COUNTER_ID=
GA_MEASUREMENT_ID=

# Mail. In development every letter goes to Mailpit: http://127.0.0.1:8025
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_STARTTLS=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=ОГК-ХИМ <noreply@ogk-chem.ru>
MAIL_REPLY_TO=order@ogk-chem.ru
SALES_EMAIL=order@ogk-chem.ru
ALERT_EMAILS=order@ogk-chem.ru

# Alerts about undelivered requests (no personal data goes to Telegram).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_AFTER_MINUTES=15

# Yandex SmartCaptcha, asked only on suspicion. Empty: suspicious requests pass and are marked.
SMARTCAPTCHA_SERVER_KEY=

# Storefront (Next.js): where /api/v1/* is proxied in development, and the SmartCaptcha client key.
API_ORIGIN=http://127.0.0.1:8001
NEXT_PUBLIC_SMARTCAPTCHA_SITE_KEY=
