# The admin panel (TZ 13) on its own name ADMIN_DOMAIN, e.g. admin.ogk-chem.ru: the static application and the admin
# contour of the API. Sign-in has its own password, second factor and CSRF; the page is never indexed.
{$ADMIN_DOMAIN} {
	import site_headers
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		X-Robots-Tag "noindex, nofollow"
		Cache-Control "no-store"
	}
	header /assets/* Cache-Control "public, max-age=31536000, immutable"
	encode zstd gzip
	route {
		reverse_proxy /api/v1/admin/* api:8000 {
			lb_try_duration 30s
			lb_try_interval 250ms
		}
		respond /api/* 404
		root * /srv/admin
		try_files {path} /index.html
		file_server
	}
}
