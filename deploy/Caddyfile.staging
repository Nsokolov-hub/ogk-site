# Staging (SITE_ENV=staging): a copy of production closed with a password and from indexing (TZ 12.3).
{
	email {$TLS_EMAIL}
	admin off
}

import conf/common.caddy

{$SITE_DOMAIN} {
	import site_headers
	header X-Robots-Tag "noindex, nofollow"
	# The CRM calls the site's integration contour with its own signature (flow F2): no password there.
	@guarded not path /api/v1/crm/*
	basic_auth @guarded {
		{$STAGING_USER} {$STAGING_PASSWORD_HASH}
	}
	# Letters of staging (COMPOSE_PROFILES=mailpit).
	handle /mailpit/* {
		reverse_proxy mailpit:8025
	}
	import site_routes
}

import conf/admin.caddy
import conf/extra/*.caddy
